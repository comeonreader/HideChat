# HideChat 环境变量 —— 复制为仓库根 .env：cp docker/.env.example .env
# 必改项：
DB_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-64-byte-random-secret
# 可选：
APP_PORT=8080
MSG_TTL_MINUTES=20
RECALL_WINDOW_MINUTES=2
UNREAD_MAX_DAYS=30
REGISTER_RATE_LIMIT=10

# 数据卷前缀（决定 pgdata/uploads/avatars 卷名）；改它等于换一套数据，勿随意改
COMPOSE_PROJECT_NAME=qingyu
